<?xml version="1.0"?>
<!-- Empty 12 x 10 metre arena. Insert/move obstacles in Gazebo and Save World As.
     Each obstacle needs a collision shape and must intersect the laser plane
     (approximately 0.11 m above the floor) to be seen by this 2D LiDAR. -->
<sdf version="1.6">
  <world name="v550_custom">
    <gravity>0 0 -9.8</gravity>
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.8 0.8 0.85 1</background>
      <shadows>false</shadows>
    </scene>
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.2 0.1 -1</direction>
      <cast_shadows>false</cast_shadows>
    </light>
    <gui><camera name="user_camera">
      <pose>0 0 12 0 1.57079632679 0</pose>
      <view_controller>orbit</view_controller>
    </camera></gui>
    <model name="floor">
      <static>true</static><pose>0 0 -0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12.4 10.4 0.1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12.4 10.4 0.1</size></box></geometry>
          <material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_north">
      <static>true</static><pose>0 5 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12.2 0.15 0.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12.2 0.15 0.6</size></box></geometry>
          <material><ambient>0.3 0.4 0.55 1</ambient><diffuse>0.3 0.4 0.55 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static><pose>0 -5 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12.2 0.15 0.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12.2 0.15 0.6</size></box></geometry>
          <material><ambient>0.3 0.4 0.55 1</ambient><diffuse>0.3 0.4 0.55 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static><pose>6 0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 10.2 0.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 10.2 0.6</size></box></geometry>
          <material><ambient>0.3 0.4 0.55 1</ambient><diffuse>0.3 0.4 0.55 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static><pose>-6 0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 10.2 0.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 10.2 0.6</size></box></geometry>
          <material><ambient>0.3 0.4 0.55 1</ambient><diffuse>0.3 0.4 0.55 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
