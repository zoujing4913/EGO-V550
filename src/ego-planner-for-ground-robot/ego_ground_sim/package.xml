<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ego_ground_sim</name>
  <version>0.0.0</version>
  <description>
    Gazebo Classic simulation for the ego-planner ground robot: differential drive
    chassis (forward + steering), obstacle arena, 3D LiDAR, odometry, TF and the
    bridge nodes that feed /state_estimation and /registered_scan to the planner.
  </description>
  <maintainer email="dango@todo.todo">dango</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_sensor_msgs</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>eigen</depend>
  <depend>ego_planner</depend>
  <depend>bspline_opt</depend>

  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ego_wheeltec</exec_depend>
  <exec_depend>patchwork</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-protobuf</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
